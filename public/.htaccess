RewriteEngine On
RewriteBase /
RewriteRule ^index\.html$ - [L]
# Build Your Houses (2026-11-05): /houses is BOTH a page of the app and a real folder (the shared
# house renderer lives in houses/). Without this, Apache treats /houses as the folder (redirect to
# /houses/, then no index -> 403) instead of serving the app.
RewriteRule ^houses/?$ /index.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# The page shell must never be cached: every deploy ships a new hashed bundle name inside it.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The shared house renderer keeps a fixed name (the apps and the web load it by that name), so it
  # must be re-checked on every visit rather than cached for a year like the hashed bundles.
  <FilesMatch "^house-view\.(js|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
